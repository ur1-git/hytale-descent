$C = "../Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 650);

    #Title {
      $C.@Title #MarketName { @Text = "Market"; }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 16);

      Label #Feedback { Anchor: (Height: 24); Style: $C.@DefaultLabelStyle; }
      Group #Listings { LayoutMode: Top; Anchor: (Height: 252); }

      Group {
        LayoutMode: Left;
        $C.@TextButton #Previous { Text: "Previous"; Anchor: (Width: 100, Right: 8); }
        Label #PageNumber { Anchor: (Width: 70); Style: $C.@DefaultLabelStyle; }
        $C.@TextButton #Next { Text: "Next"; Anchor: (Width: 100, Right: 8); }
        $C.@TextButton #Refresh { Text: "Refresh"; Anchor: (Width: 100); }
      }

      Label { Text: "List the item in your active hotbar slot"; Anchor: (Height: 30, Top: 12); Style: $C.@DefaultLabelStyle; }
      Group {
        LayoutMode: Left;
        Label { Text: "Quantity"; Anchor: (Width: 70); Style: $C.@DefaultLabelStyle; }
        $C.@TextField #Quantity { @Anchor = (Width: 70, Right: 14); Value: "1"; }
        Label { Text: "Total price"; Anchor: (Width: 80); Style: $C.@DefaultLabelStyle; }
        $C.@TextField #Price { @Anchor = (Width: 100, Right: 14); }
        $C.@TextButton #List { Text: "List item"; Anchor: (Width: 130); }
      }

      Group {
        LayoutMode: Left;
        Anchor: (Top: 12);
        Label #Proceeds { Anchor: (Width: 240); Style: $C.@DefaultLabelStyle; }
        $C.@TextButton #Claim { Text: "Claim coins"; Anchor: (Width: 130); }
      }
    }
  }
}
